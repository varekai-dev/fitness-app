---
import { Image } from 'astro:assets';
import { APK_URL } from '../data';
import { dict, langOf } from '../i18n';
import { screenshot } from '../screens';
import Icon from './Icon.astro';
import Phone from './Phone.astro';

const t = dict[langOf(Astro)];
const h = t.hero;
---

<section class="hero" id="top">
  <div class="glow" aria-hidden="true"></div>
  <div class="container grid">
    <div class="copy">
      <span class="eyebrow"><Icon name="android" size={16} /> {h.eyebrow}</span>
      <h1>
        {h.title[0]}<span class="hl">{h.title[1]}</span>
      </h1>
      <p class="lead">
        {h.lead}
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={APK_URL} data-download>
          <Icon name="download" size={20} />
          {t.download}
        </a>
        <a class="btn btn-ghost" href="#tour">{h.seeScreens}</a>
      </div>
    </div>

    <div class="visual">
      <Phone class="hero-phone">
        <Image
          src={screenshot('home', langOf(Astro))}
          alt={h.homeAlt}
          loading="eager"
          widths={[390, 780]}
          sizes="(max-width: 860px) 300px, 360px"
        />
      </Phone>
      <div class="chip chip-pr">
        <span class="chip-icon"><Icon name="trophy" size={18} /></span>
        <div><b>{h.chips.pr[0]}</b><small>{h.chips.pr[1]}</small></div>
      </div>
      <div class="chip chip-water">
        <span class="chip-icon"><Icon name="drop" size={18} /></span>
        <div><b>{h.chips.water[0]}</b><small>{h.chips.water[1]}</small></div>
      </div>
      <div class="chip chip-ai">
        <span class="chip-icon"><Icon name="sparkles" size={18} /></span>
        <div><b>{h.chips.ai[0]}</b><small>{h.chips.ai[1]}</small></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 140px 0 96px;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 900px;
    height: 900px;
    background: radial-gradient(closest-side, rgba(234, 244, 107, 0.16), transparent 70%);
    pointer-events: none;
  }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 48px;
  }
  h1 {
    font-size: clamp(38px, 6vw, 72px);
    margin-top: 20px;
  }
  .hl {
    color: var(--accent);
  }
  .lead {
    color: var(--text-secondary);
    font-size: clamp(17px, 1.7vw, 20px);
    max-width: 52ch;
    margin-top: 24px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .visual {
    position: relative;
    justify-self: center;
    width: min(360px, 100%);
  }
  .visual :global(.hero-phone) {
    transform: rotate(3deg);
    animation: float 7s ease-in-out infinite;
  }
  .chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px 12px 12px;
    border-radius: 18px;
    background: rgba(38, 38, 38, 0.82);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.8);
    white-space: nowrap;
    animation: float 6s ease-in-out infinite;
  }
  .chip div {
    display: grid;
    line-height: 1.3;
  }
  .chip b {
    font-size: 14px;
  }
  .chip small {
    color: var(--text-secondary);
    font-size: 12px;
  }
  .chip-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 12px;
    background: var(--accent);
    color: var(--accent-text);
  }
  .chip-pr {
    top: 14%;
    left: -28%;
    animation-delay: -2s;
  }
  .chip-water {
    top: 52%;
    right: -14%;
    animation-delay: -4s;
  }
  .chip-water .chip-icon {
    background: #6bc6f4;
  }
  .chip-ai {
    bottom: 8%;
    left: -24%;
  }
  .chip-ai .chip-icon {
    background: var(--carbs);
  }
  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -10px;
    }
  }
  @media (max-width: 1100px) {
    .chip-pr {
      left: -16%;
    }
    .chip-water {
      right: -6%;
    }
    .chip-ai {
      left: -12%;
    }
  }
  @media (max-width: 860px) {
    .hero {
      padding-top: 112px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .visual {
      width: min(300px, 78%);
      margin-top: 24px;
    }
    .chip-pr {
      left: -18%;
    }
    .chip-water {
      right: -18%;
    }
    .chip-ai {
      left: -14%;
    }
  }
  @media (max-width: 480px) {
    .chip {
      padding: 8px 12px 8px 8px;
      gap: 8px;
    }
    .chip-icon {
      width: 30px;
      height: 30px;
    }
    .chip small {
      display: none;
    }
    .chip-pr {
      left: -12%;
    }
    .chip-water {
      right: -12%;
    }
    .chip-ai {
      left: -8%;
    }
  }
</style>
