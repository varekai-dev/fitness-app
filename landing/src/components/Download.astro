---
import QRCode from 'qrcode';
import { APK_URL, RELEASES_URL } from '../data';
import { dict, langOf } from '../i18n';
import Icon from './Icon.astro';

// Scanned from a computer, the code downloads the APK straight to the phone.
const qr = await QRCode.toString(APK_URL, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#141414', light: '#0000' },
});

const t = dict[langOf(Astro)];
const i = t.install;
const steps = i.steps.map(([title, text]) => ({ title, text }));
---

<section class="section" id="download">
  <div class="container">
    <div class="panel reveal">
      <div class="copy">
        <span class="eyebrow"><Icon name="android" size={16} /> {i.eyebrow}</span>
        <h2 class="section-title">{i.title}</h2>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li>
                <span class="n">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="actions">
          <a class="btn btn-dark" href={APK_URL} data-download>
            <Icon name="download" size={20} />
            {t.download}
          </a>
          <a class="more" href={RELEASES_URL} target="_blank" rel="noopener">
            {i.whatsNew}
          </a>
        </div>
      </div>

      <div class="qr-card">
        <div class="qr" set:html={qr} role="img" aria-label={i.qrAlt} />
        <p>{i.scan}</p>
        <small><span data-release-size>APK</span> · <span data-release-date>Android 8.0+</span></small>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding: clamp(28px, 6vw, 72px);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 140% at 100% 0%, #f5faa8 0%, transparent 55%),
      var(--accent);
    color: var(--accent-text);
    overflow: hidden;
  }
  .eyebrow {
    color: var(--accent-text);
    opacity: 0.7;
  }
  .section-title {
    max-width: 14ch;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    display: grid;
    gap: 20px;
    max-width: 560px;
  }
  .steps li {
    display: flex;
    gap: 16px;
  }
  .n {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent-text);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 15px;
  }
  .steps h3 {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0;
  }
  .steps p {
    margin-top: 2px;
    color: rgba(20, 20, 20, 0.72);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 36px;
  }
  .btn-dark {
    background: var(--accent-text);
    color: var(--accent);
  }
  .btn-dark:hover {
    background: #000;
  }
  .more {
    font-weight: 700;
    text-underline-offset: 3px;
  }
  .qr-card {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.55);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.35);
    text-align: center;
  }
  .qr {
    width: 200px;
    margin-bottom: 10px;
  }
  .qr :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .qr-card p {
    font-weight: 800;
  }
  .qr-card small {
    color: rgba(20, 20, 20, 0.6);
    font-weight: 600;
  }
  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
    }
    /* On a phone the button itself is the way in. */
    .qr-card {
      display: none;
    }
  }
</style>
