---
/** A phone body around a screenshot (or anything slotted in). */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['phone', className]}>
  <div class="screen"><slot /></div>
</div>

<style>
  .phone {
    position: relative;
    width: 100%;
    aspect-ratio: 390 / 846;
    padding: 10px;
    border-radius: 54px;
    background: linear-gradient(145deg, #3a3a3a, #161616 40%, #2a2a2a);
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.12),
      0 40px 80px -30px rgba(0, 0, 0, 0.9),
      0 0 0 1px #000;
  }
  .screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 44px;
    background: #000;
  }
  .screen :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>
