  food: '<path d="M4 3v7a3 3 0 0 0 6 0V3M7 3v18"/><path d="M17 21V3c-2 1-3 4-3 7s1 4 3 4"/>',
  drop: '<path d="M12 2.7c3.5 4.2 6 7.6 6 11.3a6 6 0 0 1-12 0c0-3.7 2.5-7.1 6-11.3z"/>',
