{
  "expo": {
    "name": "Fitness",
    "slug": "fitness",
    "version": "1.68.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/89e0616b-90d4-4c0c-926c-ce52eeda2bd6",
      "checkAutomatically": "NEVER",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitness",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.serhijsav.fitness"
    },
    "android": {
      "package": "com.serhijsav.fitness",
      "adaptiveIcon": {
        "backgroundColor": "#EAF46B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_HEALTH_DATA_HISTORY"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Дозвольте доступ до фото, щоб додавати зображення вправ.",
          "cameraPermission": "Дозвольте доступ до камери, щоб фотографувати вправи."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Дозвольте доступ до камери, щоб фотографувати прогрес.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#EAF46B"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Fitness читає вагу та тренування, щоб показувати їх у журналі ваги та історії тренувань.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89e0616b-90d4-4c0c-926c-ce52eeda2bd6"
      }
    },
    "owner": "varekai"
  }
}
