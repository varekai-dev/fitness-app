<?xml version="1.0" encoding="utf-8"?>
<!-- One-row version of the widget, for heights too short for the full layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg"
  android:orientation="horizontal"
  android:padding="@dimen/widget_compact_padding">

  <LinearLayout
    android:id="@+id/stat_cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/widget_cell_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_cell_padding"
    android:paddingTop="@dimen/widget_compact_padding"
    android:paddingEnd="@dimen/widget_cell_padding"
    android:paddingBottom="@dimen/widget_compact_padding">

    <TextView
      android:id="@+id/stat_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="@string/widget_week"
      android:textColor="@color/widget_accent"
      android:textSize="11sp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/stat_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_sample_week"
        android:textColor="@color/widget_text"
        android:textSize="18sp" />

      <TextView
        android:id="@+id/stat_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/widget_sample_week_unit"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
