<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg"
  android:orientation="horizontal"
  android:padding="@dimen/widget_padding">

  <LinearLayout
    android:id="@+id/workout_cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/widget_accent_bg"
    android:orientation="vertical"
    android:padding="@dimen/widget_cell_padding">

    <TextView
      android:id="@+id/workout_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="@string/widget_next_workout"
      android:textColor="@color/widget_on_accent_muted"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/workout_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:ellipsize="end"
      android:fontFamily="sans-serif-black"
      android:includeFontPadding="false"
      android:maxLines="2"
      android:text="@string/widget_sample_workout"
      android:textColor="@color/widget_on_accent"
      android:textSize="22sp" />

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <TextView
      android:id="@+id/workout_subtitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="2"
      android:text="@string/widget_sample_program"
      android:textColor="@color/widget_on_accent_muted"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
