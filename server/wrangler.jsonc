{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitness-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // nodemailer needs node:net / node:tls for SMTP.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitness",
      "database_id": "aab456a4-5432-4280-ad16-ebfa31f94193",
      "migrations_dir": "migrations"
    }
  ],
  // Backups the app uploads once a day, under `<user id>/<date>.db`.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "fitness-backups" }],
  "vars": {
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "MAIL_FROM_NAME": "GetFit",
    // The admin page (/admin): an OAuth client ID of type "Web application" from
    // console.cloud.google.com/apis/credentials, with this Worker's URL (and
    // http://localhost:8787 for `wrangler dev`) as authorized JavaScript origins,
    // and the Google accounts allowed in, comma-separated.
    "GOOGLE_CLIENT_ID": "548785441149-iun2rahcarqttvacjvdihm1jhp7c9mbg.apps.googleusercontent.com",
    "ADMIN_EMAILS": "serhijsav@gmail.com",
    // The admin page shows this account's free plan usage. It also needs the
    // secret CF_API_TOKEN: a token with Account → Account Analytics → Read
    // (dash.cloudflare.com/profile/api-tokens), set with `npx wrangler secret put CF_API_TOKEN`.
    "CF_ACCOUNT_ID": "eacf2393480be5abb18c98eaf1c7d936"
  }
  // Secrets, set with `npx wrangler secret put SMTP_USER` and `… SMTP_PASS`: the
  // Gmail address and an app password for it (myaccount.google.com/apppasswords).
  // Without them reset codes are only written to the log, which is enough for
  // `wrangler dev`.
  // The Groq API key isn't a secret here: it's set on the admin page and kept in D1.
}
